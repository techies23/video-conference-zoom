{
  "name": "techies23/video-conferencing-with-zoom-api",
  "description": "Video Conferencing with Zoom",
  "type": "project",
  "authors": [
    {
      "name": "Deepen Bajracharya",
      "email": "dpen.connectify@gmail.com",
      "role": "Lead Developer"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.0",
    "firebase/php-jwt": "^7.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "brain/monkey": "^2.6"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint:php": "find includes templates -name '*.php' -print0 | xargs -0 -n1 php -l | grep -v 'No syntax errors' || true"
  },
  "autoload": {
    "psr-4": {
      "Codemanas\\VczApi\\": [
        "legacy/",
        "includes/"
      ]
    }
  }
}
