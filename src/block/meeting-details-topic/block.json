{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vczapi/meeting-details-topic",
  "version": "0.1.0",
  "title": "Meeting Details Topic",
  "category": "vczapi-blocks",
  "description": "Show the Zoom Meeting Topic",
  "ancestor": [ "vczapi/meeting-details" ],
  "usesContext": [
    "vczapi/sourceType",
    "vczapi/customMeetingId",
    "vczapi/selectedMeetingPostId"
  ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Topic:"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    }
  },
  "example": {},
  "textdomain": "video-conferencing-with-zoom-api",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}