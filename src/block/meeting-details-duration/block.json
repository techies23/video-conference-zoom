{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vczapi/meeting-details-duration",
  "version": "1.0.0",
  "title": "Zoom - Meeting Details - Duration",
  "category": "vczapi-blocks",
  "icon": "clock",
  "description": "Displays the duration of a Zoom meeting.",
  "ancestor": [ "vczapi/meeting-details" ],
  "usesContext": [
    "vczapi/sourceType",
    "vczapi/customMeetingId",
    "vczapi/selectedMeetingPostId"
  ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Duration:"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "video-conferencing-with-zoom-api",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}