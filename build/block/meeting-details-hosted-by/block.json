{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vczapi/meeting-details-hosted-by",
  "version": "1.0.0",
  "title": "Meeting Details - Hosted By",
  "category": "vczapi-blocks",
  "description": "Displays the host of the Zoom meeting.",
  "ancestor": [
    "vczapi/meeting-details"
  ],
  "usesContext": [
    "vczapi/sourceType",
    "vczapi/customMeetingId",
    "vczapi/selectedMeetingPostId"
  ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Hosted By:"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    },
    "hostType": {
      "type": "string",
      "enum": [
        "post_author",
        "custom"
      ],
      "default": "post_author"
    },
    "customHostName": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "video-conferencing-with-zoom-api",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}