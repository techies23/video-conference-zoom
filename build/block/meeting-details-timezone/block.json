{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vczapi/meeting-details-timezone",
  "version": "1.0.0",
  "title": "Zoom - Meeting Details - Timezone",
  "category": "vczapi-blocks",
  "icon": "admin-site-alt3",
  "description": "Displays the timezone of the Zoom meeting or visitor's browser.",
  "ancestor": [
    "vczapi/meeting-details"
  ],
  "usesContext": [
    "vczapi/sourceType",
    "vczapi/customMeetingId",
    "vczapi/selectedMeetingPostId"
  ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Timezone : "
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    },
    "timezoneDisplay": {
      "type": "string",
      "enum": [
        "user",
        "meeting"
      ],
      "default": "user"
    }
  },
  "textdomain": "video-conferencing-with-zoom-api",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}