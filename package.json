{
  "title": "Video Conferencing with Zoom API",
  "name": "video-conferencing-with-zoom-api",
  "version": "3.2.0",
  "description": "Add, Handle Zoom meetings from WordPress Dashboard using API",
  "author": "Deepen Bajracharya",
  "license": "GPL-2.0+",
  "scripts": {
    "copy:vendors": "cpx \"node_modules/{choices.js/public/assets/styles/**/*,flatpickr/dist/flatpickr.min.css}\" dist/vendor",
    "copy:sdk": "cpx \"node_modules/@zoom/meetingsdk/{helper.html,externalLinkPage.html}\" \"dist/vendor/zoom/websdk\"",
    "build": "pnpm run copy:vendors && pnpm run copy:sdk && wp-scripts build",
    "start": "pnpm run copy:vendors && pnpm run copy:sdk && wp-scripts start --mode development",
    "format:js": "wp-scripts format-js",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update"
  },
  "browserslist": [
    "defaults",
    "> 0.5%",
    "not dead"
  ],
  "repository": "https://github.com/techies23/video-conference-zoom",
  "dependencies": {
    "@zoom/meetingsdk": "^6.5.0",
    "choices.js": "^11.2.4",
    "datatables.net": "^3.1.3",
    "datatables.net-dt": "^3.1.3",
    "datatables.net-responsive": "^4.1.1",
    "datatables.net-responsive-dt": "^4.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "flatpickr": "^4.6.13",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@wordpress/block-editor": "^17.1.0",
    "@wordpress/blocks": "^15.27.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/scripts": "^34.2.0",
    "@wordpress/server-side-render": "^6.32.0",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "cpx2": "^8.0.2",
    "css-loader": "^7.1.5",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.0",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1"
  }
}